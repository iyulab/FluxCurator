<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Flux Ecosystem -->
    <PackageVersion Include="Flux.Abstractions" Version="0.27.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <!-- Testing: xUnit v3/MTP native mode - no Microsoft.NET.Test.Sdk needed, coverlet.collector
         was a dead reference (CI never invoked the coverage collector flag) -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Iyu.Conventions.Testing" Version="0.13.0" />
    <PackageVersion Include="Iyu.Conventions.Testing.Snippets" Version="0.13.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
  </ItemGroup>
</Project>